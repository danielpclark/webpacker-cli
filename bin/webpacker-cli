#!/usr/bin/env ruby

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'webpacker_cli'

USAGE = <<~TEXT
  webpacker-cli #{WebpackerCli::VERSION}

  Usage: webpacker-cli <command> [options]

  Commands:
    init       Create config, entry pack and package.json, then install Node packages
                 --force         overwrite existing files
                 --skip-install  don't install Node packages
    compile    Compile packs into the public output directory (writes manifest.json)
    watch      Compile and recompile on changes
    clobber    Remove compiled packs and the Webpack cache
    check      Verify Node, package manager and installed packages
    info       Show tool versions
    version    Show the webpacker-cli version

  The environment is taken from WEBPACKER_ENV, NODE_ENV or RAILS_ENV (default: development).
  Run `webpacker-cli init` first in your project directory.
TEXT

command, *args = ARGV

begin
  case command
  when 'init'
    puts 'INITIALIZING WEBPACKER…'
    WebpackerCli.init(force: args.include?('--force'), install: !args.include?('--skip-install'))
  when 'compile'
    WebpackerCli.compile
  when 'watch'
    WebpackerCli.watch
  when 'clobber'
    WebpackerCli.clobber
  when 'check'
    problems = WebpackerCli.check
    puts(problems.empty? ? 'Everything looks good.' : problems)
    exit(problems.empty? ? 0 : 1)
  when 'info'
    WebpackerCli.info.each { |k, v| puts "#{k}: #{v}" }
  when 'version', '--version', '-v'
    puts WebpackerCli::VERSION
  when nil, 'help', '--help', '-h'
    puts USAGE
  else
    warn "Unknown command: #{command}\n\n#{USAGE}"
    exit 1
  end
rescue WebpackerCli::Error => e
  warn e.message
  exit 1
end
